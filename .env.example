# Export the variables needed by your deployment before starting Dabba.
DABBA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DABBA_DATA_DIR=/path/to/private/dabba-data
# DABBA_MASTER_KEY=replace-with-a-fernet-key-from-your-secret-manager
# Provider keys are read from the environment when none is saved in the app.
# Set only the ones you use; keep real values in your host's secret settings.
# ANTHROPIC_API_KEY=replace-with-your-provider-key
# OPENAI_API_KEY=replace-with-your-provider-key
# GEMINI_API_KEY=replace-with-your-provider-key
# NVIDIA_API_KEY=replace-with-your-provider-key
# HF_TOKEN=replace-with-your-provider-key
